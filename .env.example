# All values are optional. The firm reads Solana mainnet; public endpoints are used by default.

# Dedicated Solana mainnet RPC (server-only). Helius mainnet preferred, e.g.
# https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_MAINNET=
SOLANA_RPC_URL=

# Public Solana mainnet RPC (client-safe, no API key). Falls back to public mainnet-beta.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# The server never accepts or stores a private key. Do not add one here.
